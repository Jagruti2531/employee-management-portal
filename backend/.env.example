# Leave these blank for the default EASY LOCAL H2 setup.
# For Supabase, set these values in your terminal/deployment environment.
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
JWT_SECRET=replace-with-a-long-random-secret
